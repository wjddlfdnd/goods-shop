# 로컬 개발 값. 실제 배포 값은 커밋하지 않는다.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/goodsshop?schema=public"

# 배포(Vercel) 환경 변수 — docs/06-배포.md
# DATABASE_URL           Neon 연결 풀 URL(Vercel의 Neon 연동이 자동으로 넣음)
# DATABASE_URL_UNPOOLED  Neon 직접 연결 URL(마이그레이션용, Neon 연동이 자동으로 넣음)
# BLOB_READ_WRITE_TOKEN  Vercel Blob 저장소를 연결하면 자동으로 들어감. 없으면 uploads/ 폴더에 저장
# ADMIN_EMAIL            배포 환경 관리자 이메일(빌드 때 계정을 만들거나 비밀번호를 맞춤)
# ADMIN_PASSWORD         배포 환경 관리자 비밀번호(8자 이상, 개발용 admin1234 쓰지 말 것)
